    private string AreaDisplayName(int areaNumber)
    {
        var area = ShuntingAreas.FirstOrDefault(a => a.Number == areaNumber);
        return area is null ? areaNumber.ToString() : $"{area.Number} {TranslateLabel(area.Name)}";
    }

    private string ReleaseRequestText => _releaseRequests.Count == 0
        ? ""
        : $"{Messages.ShuntingAreaRequests}: {string.Join(", ", _releaseRequests.Select(AreaDisplayName))}";

    private Signal GetSignal(SignalDefinition definition)
    {
        var signal = Signal.FromDefinition(definition);
        if (int.TryParse(definition.Name, out var signalNumber))
            signal.State = SignalStateService.GetSignalState(StationName, signalNumber);
        return signal;
    }

    /// <summary>
    /// Resolves how a signal is presented, in the priority order TRVINFRA-00305 6.2.3-6.2.5
    /// assigns: releasing beats proceed, and proceed beats being a route destination.
    /// </summary>
    private SignalAspect GetSignalAspect(SignalDefinition definition)
    {
        if (!int.TryParse(definition.Name, out var signalNumber)) return SignalAspect.Stop;
        if (_cancellingRouteLinks.Keys.Any(k => k.from == signalNumber || k.to == signalNumber))
            return SignalAspect.Releasing;
        if (_shuntingRouteLinks.Keys.Any(k => k.from == signalNumber) || IsOnShuntingRoute(signalNumber))
            return SignalAspect.ProceedShunting;
        if (SignalStateService.GetSignalState(StationName, signalNumber) == SignalState.Go)
            return SignalAspect.Proceed;
        if (_routeLinks.Keys.Any(k => k.to == signalNumber) || _shuntingRouteLinks.Keys.Any(k => k.to == signalNumber))
            return SignalAspect.RouteEnd;
        return SignalAspect.Stop;
    }

    /// <summary>
    /// A signal a shunting route passes through shows the shunting aspect as well:
    /// green dwarf part against a grey main part. Intermediate signals are not part of
    /// the route link keys, so they are read from the active routes.
    /// </summary>
    private bool IsOnShuntingRoute(int signalNumber) =>
        LockingsManager.GetForStation(StationName).CurrentRoutes
            .Any(r => r.State == TrainRouteState.SetShunting && r.IntermediateSignals.Contains(signalNumber));

    /// <summary>Length along the track of a signal symbol, which a main dwarf signal doubles.</summary>
    private static double SignalSymbolLength(SignalType type) => type switch
    {
        SignalType.MainDwarf => SignalPairLength,
        SignalType.BufferStop => SignalBufferStopLength,
        _ => SignalElementLength
    };

    /// <summary>
    /// The angle in degrees of the track leading up to a coordinate, measured in the rendered
    /// frame from the coordinate toward its one neighbour, so that a buffer stop on a gradient
    /// turns with the track it closes. Only a track end has a single neighbour to turn to.
    /// </summary>
    private double TrackAngleAt(SignalDefinition definition)
    {
        if (!definition.Type.IsBufferStop) return 0;
        var link = Topology.Graph.GetLinksAt(definition.Coordinate).FirstOrDefault();
        if (link is null) return 0;

        var neighbour = link.FromNode.Coordinate == definition.Coordinate
            ? link.ToNode.Coordinate
            : link.FromNode.Coordinate;
        var (nodeX, nodeY) = ToPixel(definition.Coordinate);
        var (neighbourX, neighbourY) = ToPixel(neighbour);
        return Math.Atan2(neighbourY - nodeY, neighbourX - nodeX) * 180.0 / Math.PI;
    }

    /// <summary>A buffer stop can only end a movement, never start one and never show go.</summary>
    private bool IsBufferStop(string signalName) =>
        Topology.Signals.Any(signal => signal.Name == signalName && signal.Type.IsBufferStop);

    /// <summary>
    /// A train number is written in the colour of the stretch it stands on, so the words and the
    /// picture say the same thing. The stretch a train occupies is drawn red, so the number
    /// naming that train is red; the same number repeated along its route wears the colour of the
    /// route. The order is the priority order of §6.2.1: occupied beats every route colour.
    /// </summary>
    private string TrainNumberColour(int sectionNumber)
    {
        if (!_occupancySectionTracks.TryGetValue(sectionNumber, out var track)) return EbicosColours.White;
        if (track.Links.Any(_occupiedLinks.Contains)) return EbicosColours.Red;
        if (track.Links.Any(_activeCancellingRouteLinks.Contains)) return EbicosColours.Magenta;
        if (track.Links.Any(_activeRouteLinks.Contains)) return EbicosColours.Green;
        if (track.Links.Any(_activeShuntingRouteLinks.Contains)) return EbicosColours.Yellow;
        return EbicosColours.White;
    }

    /// <summary>
    /// Where a label belonging to a stretch is drawn, and which way round it is turned. The
    /// stretch names the run to write it along — <see cref="OccupancySectionExtensions"/> picks a
    /// level one wherever it has any, and otherwise the longest slope — and what is added here is
    /// the drawing: the middle of that run in pixels, and the angle to turn the text to. A
    /// five-digit number at <see cref="TrainNumberFontSize"/> is narrower than the one cell that
    /// is the shortest run Munkeröd ever offers, so a level run always has room for it.
    /// </summary>
    private (double X, double Y, double Angle)? SectionLabelAnchor(int sectionNumber)
    {
        if (!_occupancySectionTracks.TryGetValue(sectionNumber, out var track) || track.LabelRun is not { } run) return null;

        var (x1, y1) = ToPixel(run.From);
        var (x2, y2) = ToPixel(run.To);

        // Text is never set upside down: a run walked right to left is read from its other end,
        // which is the same line half a turn back. The inverted view arrives here as exactly that
        // case, since it turns the whole yard round.
        var angle = Math.Atan2(y2 - y1, x2 - x1) * 180.0 / Math.PI;
        if (angle > 90) angle -= 180;
        else if (angle <= -90) angle += 180;

        return ((x1 + x2) / 2.0, (y1 + y2) / 2.0, angle);
    }

    /// <summary>
    /// The baseline a train number is written on: <see cref="TrainNumberOffset"/> clear of the
    /// rails, measured perpendicular to the run the number is set along, so a number over a
    /// slanting run keeps the same gap its whole length. The perpendicular taken is the one
    /// pointing up the screen, which over a level run is straight up — where the numbers stood
    /// before there was anything else for them to stand on.
    /// </summary>
    private static (double X, double Y) TrainNumberBaseline((double X, double Y, double Angle) anchor)
    {
        var radians = anchor.Angle * Math.PI / 180.0;
        return (anchor.X + Math.Sin(radians) * TrainNumberOffset, anchor.Y - Math.Cos(radians) * TrainNumberOffset);
    }

    private string FormatQueuedRoute(int fromSignal, int toSignal, string? trainNumber)
    {
        var effective = trainNumber ?? (
            Topology.SectionLeadingUpTo(fromSignal, OccupancySections, _occupancySectionTracks) is { } section
                ? TrainNumberService.GetTrainNumber(StationName, section)
                : null);
        return effective is null
            ? $"{fromSignal}.{toSignal}"
            : $"{TrainNumberDisplay.Format(effective)} {fromSignal}.{toSignal}";
    }

    /// <summary>
    /// One tap does everything a tablet has to offer: it starts a route, it ends one, it asks to
    /// clear the route it starts from, and on a signal nothing follows it gives that signal go.
    /// The keyboard shortcuts remain for the dispatcher at the desk.
    /// </summary>
    private void OnSignalClicked(SignalClick args)
    {
        var signalName = args.SignalName;
        var signalNumber = int.TryParse(signalName, out var parsed) ? parsed : 0;

        // CTRL+click on a signal that is part of an active route cancels that route
        if (args.CtrlKey)
        {
            if (Role == OperatorRole.Dispatcher && signalNumber > 0)
            {
                var activeRoute = FindActiveRouteAt(signalNumber);
                if (activeRoute != default) EnqueueCommand($"{activeRoute.to}/");
            }
            ClearSelection();
            return;
        }

        // Shift+click toggles signal between Stop and Go
        if (args.ShiftKey)
        {
            if (Role == OperatorRole.Dispatcher) ToggleSignal(signalNumber);
            ClearSelection();
            return;
        }

        // Second tap on the from signal confirms clearing the route that starts there.
        if (_pendingClearSignal == signalName)
        {
            var pendingRoute = FindActiveRouteFrom(signalNumber);
            ClearSelection();
            if (pendingRoute != default) EnqueueCommand($"{pendingRoute.to}/");
            return;
        }
        ClearPendingClear();

        var routeFromHere = FindActiveRouteFrom(signalNumber);
        if (routeFromHere != default)
        {
            _selectedFromSignal = null;
            _pendingClearSignal = signalName;
            var isShuntingRoute = _shuntingRouteLinks.ContainsKey(routeFromHere);
            SetFeedback(RouteMessages.ConfirmClear(isShuntingRoute, routeFromHere.from, routeFromHere.to), StatusSubject.Releasing);
            StartPendingClearTimer();
            return;
        }

        // Nothing follows this signal, so a tap cannot mean "set a route from here" and is free
        // to mean "let the movement that ends here pass you".
        if (IsToggleableEndSignal(signalNumber))
        {
            ToggleSignal(signalNumber);
            ClearSelection();
            return;
        }

        // Only allow clicking Stop (red) signals
        if (signalNumber > 0 && SignalStateService.GetSignalState(StationName, signalNumber) == SignalState.Go)
            return;

        if (_selectedFromSignal is null)
        {
            // A buffer stop ends a movement and never starts one, so it is only ever the second tap.
            if (!IsBufferStop(signalName)) _selectedFromSignal = signalName;
        }
        else if (_selectedFromSignal == signalName)
        {
            _selectedFromSignal = null;
        }
        else
        {
            EnqueueCommand($"{_selectedFromSignal}.{signalName}#");
            _selectedFromSignal = null;
        }
    }

    /// <summary>
    /// A tap on a point label throws the point. The label carries a transparent hit area wider
    /// than the text so a finger finds it, and the command travels the same pipeline as the
    /// keypad's, which is what decides whether this role may move this point.
    /// </summary>
    private void OnPointClicked(string label)
    {
        var (pointNumber, _) = GetPointNumberAndSubPoint(label);
        if (pointNumber <= 0) return;
        ClearSelection();
        var position = PointPositionService.GetPosition(StationName, pointNumber);
        var wanted = position == PointPosition.Straight ? PointPosition.Diverging : PointPosition.Straight;
        EnqueueCommand($"{pointNumber}{wanted.Sign}");
    }

    private void EnqueueCommand(string command) =>
        BufferedKeyReader.EnqueueKeys(
            command.Select(c => new ConsoleKeyInfo(c, c.ConsoleKey, false, false, false)), StationName, Role);

    private (int from, int to) FindActiveRouteAt(int signalNumber)
    {
        var route = _routeLinks.Keys.FirstOrDefault(k => k.from == signalNumber || k.to == signalNumber);
        return route != default ? route : _shuntingRouteLinks.Keys.FirstOrDefault(k => k.from == signalNumber || k.to == signalNumber);
    }

    private (int from, int to) FindActiveRouteFrom(int signalNumber)
    {
        if (signalNumber <= 0) return default;
        var route = _routeLinks.Keys.FirstOrDefault(k => k.from == signalNumber);
        return route != default ? route : _shuntingRouteLinks.Keys.FirstOrDefault(k => k.from == signalNumber);
    }

    /// <summary>
    /// True for the destination signal of an active route that no other signal follows, and only
    /// while this role owns that route. Giving such a signal go lets the movement continue past
    /// the last point the interlocking has a say over. A buffer stop is excluded: there is
    /// nothing beyond it to let a movement continue to.
    /// </summary>
    private bool IsToggleableEndSignal(int signalNumber)
    {
        if (signalNumber <= 0 || !_terminalSignals.Contains(signalNumber)) return false;
        if (IsBufferStop(signalNumber.ToString())) return false;
        var route = LockingsManager.GetForStation(StationName).CurrentRoutes.FirstOrDefault(r => r.ToSignal == signalNumber);
        if (route is null) return false;
        return Role == OperatorRole.Dispatcher || route.IsWithinShuntingAreas(_releasedAreas, _pointsByNumber);
    }

    private void ToggleSignal(int signalNumber)
    {
        if (signalNumber <= 0) return;
        var signal = YardDataService.Signals.FirstOrDefault(s => s.Name == signalNumber.ToString());
        if (signal is null) return;
        var state = SignalStateService.GetSignalState(StationName, signalNumber) == SignalState.Go ? SignalState.Stop : SignalState.Go;
        var command = new SignalCommand(signalNumber, signal.Address, state) { FeedbackAddress = signal.FeedbackAddress };
        _ = YardController.SendSignalCommandAsync(command, CancellationToken.None);
    }

    private void ClearSelection()
    {
        _selectedFromSignal = null;
        ClearPendingClear();
    }

    private void ClearPendingClear()
    {
        _pendingClearSignal = null;
        _pendingClearTimer?.Dispose();
        _pendingClearTimer = null;
    }

    /// <summary>An unanswered clear confirmation lapses, so a stray tap cannot arm it forever.</summary>
    private void StartPendingClearTimer()
    {
        _pendingClearTimer?.Dispose();
        _pendingClearTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _pendingClearSignal = null;
                StateHasChanged();
            });
        }, null, PendingClearMilliseconds, Timeout.Infinite);
    }

    private void OnRouteChanged(TrainRouteResult result)
    {
        // Ignore notifications for other stations
        if (!string.IsNullOrEmpty(result.StationName) &&
            !result.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase))
            return;

        InvokeAsync(() =>
        {
            switch (result.ResultType)
            {
                case TrainRouteResultType.Set:
                    var links = FindRouteLinks(result.Route);
                    if (result.Route.State == TrainRouteState.SetShunting)
                    {
                        _shuntingRouteLinks[(result.Route.FromSignal, result.Route.ToSignal)] = links;
                        RecomputeActiveShuntingRouteLinks();
                    }
                    else
                    {
                        _routeLinks[(result.Route.FromSignal, result.Route.ToSignal)] = links;
                        RecomputeActiveRouteLinks();
                    }
                    SetFeedback(result, result.Message ?? "", result.Route.State.IsShunting ? StatusSubject.ShuntingRoute : StatusSubject.TrainRoute);
                    break;
                case TrainRouteResultType.Rejected:
                    SetFeedback(result, result.Message ?? "", StatusSubject.Refused);
                    break;
                case TrainRouteResultType.Cancelling:
                    var cancelFrom = result.Route.FromSignal;
                    var cancelTo = result.Route.ToSignal;
                    if (cancelFrom == 0)
                    {
                        var match = _routeLinks.Keys.FirstOrDefault(k => k.to == cancelTo);
                        if (match == default)
                            match = _shuntingRouteLinks.Keys.FirstOrDefault(k => k.to == cancelTo);
                        if (match != default) cancelFrom = match.from;
                    }
                    // Move from active (green/yellow) to cancelling (purple)
                    if (_routeLinks.TryGetValue((cancelFrom, cancelTo), out var cancelLinks))
                    {
                        _cancellingRouteLinks[(cancelFrom, cancelTo)] = cancelLinks;
                        _routeLinks.Remove((cancelFrom, cancelTo));
                        RecomputeActiveRouteLinks();
                        RecomputeCancellingRouteLinks();
                    }
                    else if (_shuntingRouteLinks.TryGetValue((cancelFrom, cancelTo), out var cancelShuntingLinks))
                    {
                        _cancellingRouteLinks[(cancelFrom, cancelTo)] = cancelShuntingLinks;
                        _shuntingRouteLinks.Remove((cancelFrom, cancelTo));
                        RecomputeActiveShuntingRouteLinks();
                        RecomputeCancellingRouteLinks();
                    }
                    SetFeedback(result, result.Message ?? "", StatusSubject.Releasing);
                    break;
                case TrainRouteResultType.Cleared:
                    var clearedFrom = result.Route.FromSignal;
                    var clearedTo = result.Route.ToSignal;
                    // When cleared by TO signal only (FromSignal==0), find the actual route
                    if (clearedFrom == 0)
                    {
                        var match = _routeLinks.Keys.FirstOrDefault(k => k.to == clearedTo);
                        if (match == default)
                            match = _shuntingRouteLinks.Keys.FirstOrDefault(k => k.to == clearedTo);
                        if (match == default)
                            match = _cancellingRouteLinks.Keys.FirstOrDefault(k => k.to == clearedTo);
                        if (match != default) clearedFrom = match.from;
                    }
                    _routeLinks.Remove((clearedFrom, clearedTo));
                    _shuntingRouteLinks.Remove((clearedFrom, clearedTo));
                    _cancellingRouteLinks.Remove((clearedFrom, clearedTo));
                    RecomputeActiveRouteLinks();
                    RecomputeActiveShuntingRouteLinks();
                    RecomputeCancellingRouteLinks();
                    SetFeedback(result, result.Message ?? "", StatusSubject.Releasing);
                    break;
                case TrainRouteResultType.AllCancelling:
                    // Move all routes from green/yellow to purple
                    foreach (var kvp in _routeLinks)
                        _cancellingRouteLinks[kvp.Key] = kvp.Value;
                    foreach (var kvp in _shuntingRouteLinks)
                        _cancellingRouteLinks[kvp.Key] = kvp.Value;
                    _routeLinks.Clear();
                    _shuntingRouteLinks.Clear();
                    RecomputeActiveRouteLinks();
                    RecomputeActiveShuntingRouteLinks();
                    RecomputeCancellingRouteLinks();
                    SetFeedback(result, result.Message ?? "", StatusSubject.Releasing);
                    break;
                case TrainRouteResultType.AllCleared:
                    _routeLinks.Clear();
                    _shuntingRouteLinks.Clear();
                    _cancellingRouteLinks.Clear();
                    _activeRouteLinks = new();
                    _activeShuntingRouteLinks = new();
                    _activeCancellingRouteLinks = new();
                    RecomputeOccupiedLinks();
                    // Note: queued routes are NOT cleared by // (clear all)
                    SetFeedback(result, result.Message ?? "", StatusSubject.Releasing);
                    break;
                case TrainRouteResultType.Queued:
                    _queuedRoutes.Add((result.Route.FromSignal, result.Route.ToSignal, result.TrainNumber, result.Route.State));
                    SetFeedback(result, result.Message ?? "", result.Route.State.IsShunting ? StatusSubject.ShuntingRoute : StatusSubject.TrainRoute);
                    break;
                case TrainRouteResultType.QueuedCancelled:
                    _queuedRoutes.RemoveAll(q => q.ToSignal == result.Route.ToSignal);
                    if (!string.IsNullOrEmpty(result.Message))
                        SetFeedback(result, result.Message, StatusSubject.Releasing);
                    break;
            }
            StateHasChanged();
        });
    }

    private void OnPointChanged(PointResult result)
    {
        // Ignore notifications for other stations
        if (!string.IsNullOrEmpty(result.StationName) &&
            !result.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase))
            return;

        InvokeAsync(() =>
        {
            // A message about a point wears the colour a point label is drawn in, unless the
            // command was refused — then it has to read as a refusal, not as a point.
            var subject = result.ResultType switch
            {
                PointResultType.Set or PointResultType.AlreadyInPosition => StatusSubject.Point,
                _ => StatusSubject.Refused
            };
            SetFeedback(result, result.Message ?? "", subject);
            StateHasChanged();
        });
    }

    /// <summary>
    /// A message the input pipeline raised, shown only where it is addressed to the operator at
    /// this screen. The two work different parts of the same yard and each reads the answers to
    /// their own commands — a route the other one set names nothing this one can act on, and a
    /// refusal belongs to whoever was refused. What the message reports about the yard has
    /// already been acted on by the time this is called: the diagram shows every route, point and
    /// signal whichever of them moved it.
    /// </summary>
    private void SetFeedback(IOperatorMessage notification, string message, StatusSubject subject)
    {
        if (!notification.IsFor(Role)) return;
        SetFeedback(message, subject);
    }

    private void SetFeedback(string message, StatusSubject subject)
    {
        _feedbackMessage = message;
        _feedbackSubject = subject;
        _feedbackTimer?.Dispose();
        _feedbackTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _feedbackMessage = null;
                StateHasChanged();
            });
        }, null, 5000, Timeout.Infinite);
    }

    /// <summary>What is being typed at this station, on either input device (§8).</summary>
    private EntryState _entry = EntryState.Idle("");

    private void OnEntryChanged(EntryState state)
    {
        if (!state.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;
        // Both devices publish into one station-wide entry, so the role is what tells the
        // dispatcher's typing from the shunter's. Without it each of them would watch the
        // other's digits appear under their own diagram, and their signals blink for them.
        if (state.Role != Role) return;
        _entry = state;

        // A refused press goes to the status line, in red, and clears itself after a few seconds —
        // the same path every other refusal in the yard already takes. Red whatever it regards: a
        // message saying nothing happened must not read like one saying something did.
        if (state.Rejection is { Length: > 0 } rejection) SetFeedback(rejection, StatusSubject.Refused);

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// True while a signal's number still matches the digits entered so far. Nothing blinks once
    /// the number has resolved, and nothing blinks before a digit is typed — every signal matching
    /// no digits at all would be the whole diagram.
    /// </summary>
    private bool IsEntryCandidate(string signalName) =>
        _entry.Candidates.Count > 0
        && int.TryParse(signalName, out var number)
        && _entry.Candidates.Contains(number);

    /// <summary>
    /// What the entry regards, so the line is drawn in the colour of the object it is about — the
    /// same rule the status line follows. An entry with no command chosen regards nothing yet.
    /// </summary>
    private StatusSubject EntrySubject => _entry.Command switch
    {
        PanelCommand.TrainRouteSet or PanelCommand.TrainApproved
            or PanelCommand.TrainAdvance => StatusSubject.TrainRoute,
        PanelCommand.ShuntingRouteSet => StatusSubject.ShuntingRoute,
        PanelCommand.TrainRouteCancel or PanelCommand.ShuntingRouteRelease => StatusSubject.Releasing,
        PanelCommand.PointStraight or PanelCommand.PointDiverging
            or PanelCommand.PointLock or PanelCommand.PointUnlock => StatusSubject.Point,
        PanelCommand.ShuntingAreaLock or PanelCommand.ShuntingAreaRelease => StatusSubject.ShuntingArea,
        _ => StatusSubject.None,
    };

    public void Dispose()
    {
        TrainRouteNotifications.RouteChanged -= OnRouteChanged;
        PointNotifications.PointChanged -= OnPointChanged;
        PointPositionService.PositionChanged -= OnPointPositionChanged;
        SignalStateService.SignalStateChanged -= OnSignalStateChanged;
        TrainNumberService.TrainNumberChanged -= OnTrainNumberChanged;
        ShuntingAreaService.ShuntingAreaChanged -= OnShuntingAreaChanged;
        ShuntingAreaService.ReleaseRequestChanged -= OnReleaseRequestChanged;
        OccupancyService.OccupancyChanged -= OnOccupancyChanged;
        OccupancyHoldService.HoldChanged -= OnOccupancyHoldChanged;
        EntryStateService.EntryChanged -= OnEntryChanged;
        _feedbackTimer?.Dispose();
        _pendingClearTimer?.Dispose();
    }

    private int ViewBoxWidth => Topology.MaxColumn * CellSize;
    private int ViewBoxHeight => (Topology.MaxRow + 1) * CellSize;
    // Three lines: the status message, the queued routes, and the areas a shunter asks for.
    private int StatusBarHeight => (TitleFontSize + 16) + (TitleFontSize + 8) * 2;
    private int TotalViewBoxHeight => ViewBoxHeight + StatusBarHeight;
    private int TitleFontSize => 20;

    private string StatusText => _feedbackMessage is not null
        ? _feedbackMessage
        : _selectedFromSignal is not null
            ? string.Format(Messages.SelectToSignal, _selectedFromSignal)
            : _routeLinks.Count > 0 || _shuntingRouteLinks.Count > 0
                ? Messages.SelectFromSignalWithClearHint
                : Messages.SelectFromSignal;

    // The status line carries the colour of the object its message regards, so a message reads
    // as the text form of what the tracks and symbols are already showing.
    private string StatusTextColor => _feedbackMessage is not null
        ? SubjectColour(_feedbackSubject)
        : _selectedFromSignal is not null
            ? EbicosColours.Yellow
            : EbicosColours.Grey;

    private static string SubjectColour(StatusSubject subject) => subject switch
    {
        StatusSubject.TrainRoute => EbicosColours.Green,
        StatusSubject.ShuntingRoute => EbicosColours.Yellow,
        StatusSubject.Releasing or StatusSubject.Point => EbicosColours.Magenta,
        StatusSubject.ShuntingArea => EbicosColours.Blue,
        StatusSubject.Refused => EbicosColours.Red,
        _ => EbicosColours.Grey
    };
    private int PointLabelFontSize => 12;
    private int FontSize => 10;
    private int GridLabelFontSize => 8;

    // Air on either side of a label's text, between the glyphs and the edge of the patch that
    // clears the track behind them.
    private const double LabelBackgroundPadding = 3;

    // A label this short is a track number, not a name, and is drawn at twice the font size.
    private const int ShortLabelMaxLength = 3;

    /// <summary>
    /// The width a run of text takes at a given font size. The diagram is built server-side, so
    /// nothing can measure the glyphs; these are the average advance widths of the sans-serif
    /// faces a browser picks, which is close enough for a patch that only has to clear the text.
    /// </summary>
    private static double EstimatedTextWidth(string text, double fontSize)
    {
        var widths = 0.0;
        foreach (var c in text)
        {
            widths += c switch
            {
                'i' or 'j' or 'l' or 'I' or 't' or 'f' or 'r' or ' ' or '.' or ',' or ':' or ';' or '\'' => 0.30,
                'm' or 'w' or 'M' or 'W' => 0.85,
                >= 'A' and <= 'Z' => 0.68,
                _ => 0.55
            };
        }
        return widths * fontSize;
    }
    // A platform is drawn 150% of the track width, and stands off the rails by a gap so the eye
    // reads two objects rather than one thick line — mind the gap.
    private double PlatformWidth => TrackThickness * 1.5;
    private const double PlatformGap = 4;
    private double PlatformDistance => TrackThickness / 2.0 + PlatformGap + PlatformWidth / 2.0;

    private double GapSize => TrackThickness / 2.0 + 1; // Half length of the break across the track

    // The mark on a stretch held occupied by hand. Wider than the track so it reads as something
    // sitting on the stretch rather than as a thickening of it.
    private double HoldMarkerRadius => TrackThickness * 0.9;
    private int GapWidth => 4; // How wide the break in the track line is
    private int PointLabelOffset => 18 + TrackThickness * 2;

    // A finger needs more than the label glyphs to aim at, but not so much that the hit areas of
    // two points at the same throat overlap.
    private const int PointHitWidth = 32;
    private const int PointHitHeight = 24;
    private const int PendingClearMilliseconds = 5000;

    // Signal symbol metrics, kept in step with SignalView.
    private const double SignalElementLength = 16;
    private const double SignalPairLength = 35;
    private const double SignalBufferStopLength = 21;
    private const double TrainNumberGap = 4;
    private const double TrainNumberOffset = 11;
    private const int TrainNumberFontSize = 11;

    private static string F(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private string TranslateLabel(string text) =>
        LabelTranslator?.Translate(text, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName) ?? text;

    private static (int Number, char? SubPoint) GetPointNumberAndSubPoint(string label)
    {
        var digits = new string(label.TakeWhile(char.IsDigit).ToArray());
        var number = int.TryParse(digits, out var n) ? n : 0;
        char? subPoint = digits.Length < label.Length && char.IsLetter(label[digits.Length])
            ? char.ToLower(label[digits.Length]) : null;
        return (number, subPoint);
    }

    /// <summary>
    /// How far and in which direction a platform is shifted off the stretch it serves. The shift
    /// is perpendicular to the track, so a platform alongside a slanting stretch keeps the same
    /// gap its whole length. <see cref="PlatformSide"/> reads off the drawn diagram, and the
    /// inverted view turns the whole yard half a turn, so there an "under" platform is drawn
    /// above its track — the same side of the same track, seen from the other end of the yard.
    /// </summary>
    private (double X, double Y) PlatformOffset(double x1, double y1, double x2, double y2, PlatformSide side)
    {
        var isDownwards = (side == PlatformSide.Under) != IsInverted;

        var dx = x2 - x1;
        var dy = y2 - y1;
        var length = Math.Sqrt(dx * dx + dy * dy);
        if (length == 0) return (0, isDownwards ? PlatformDistance : -PlatformDistance);

        // The perpendicular of the stretch, turned to point to the side the platform lies on.
        // A stretch running straight up and down has no such side; its perpendicular is level
        // either way, so it is left as it comes out.
        var perpX = -dy / length;
        var perpY = dx / length;
        if (Math.Abs(perpY) > 0.001 && perpY > 0 != isDownwards) (perpX, perpY) = (-perpX, -perpY);

        return (perpX * PlatformDistance, perpY * PlatformDistance);
    }

    /// <summary>
    /// The break across the arm a point is turned away from, ready for a <c>polygon</c>. The
    /// geometry is <see cref="TrackCutOff"/>'s; this only turns it into the points attribute.
    /// </summary>
    private string? PointCutOff(int sx, int sy, int towardX, int towardY, double alongX, double alongY) =>
        Polygon(TrackCutOff.AtPoint(sx, sy, towardX, towardY, alongX, alongY, TrackThickness));

    /// <summary>
    /// The break across an arm of a way through a plain crossing that is not laid. A crossing is
    /// cut in the closed arm's own frame rather than the diagram's, which is why it does not share
    /// <see cref="PointCutOff"/>.
    /// </summary>
    private string? CrossingCutOff(int cx, int cy, int armX, int armY, double alongX, double alongY) =>
        Polygon(TrackCutOff.AtCrossing(cx, cy, armX, armY, alongX, alongY, TrackThickness));

    private static string? Polygon((double X, double Y)[]? corners) =>
        corners is null ? null : string.Join(' ', corners.Select(corner => $"{F(corner.X)},{F(corner.Y)}"));

    /// <summary>The end of the link that is not the coordinate given.</summary>
    private static GridCoordinate OtherEnd(TrackLink link, GridCoordinate coordinate) =>
        link.FromNode.Coordinate == coordinate ? link.ToNode.Coordinate : link.FromNode.Coordinate;

    private (int x, int y) ToPixel(GridCoordinate coord)
        => IsInverted
            ? ((Topology.MaxColumn - coord.Column) * CellSize, (Topology.MaxRow - coord.Row + 1) * CellSize)
            : (coord.Column * CellSize, coord.Row * CellSize);

    private (double x, double y, double angle) CalculatePointLabelPosition(int sx, int sy, int strX, int strY, int divX, int divY)
    {
        var strDx = strX - sx;
        var strDy = strY - sy;
        var strLen = Math.Sqrt(strDx * strDx + strDy * strDy);

        var divDx = divX - sx;
        var divDy = divY - sy;
        var divLen = Math.Sqrt(divDx * divDx + divDy * divDy);

        if (strLen == 0 || divLen == 0)
            return (sx, sy, 0);

        var strUx = strDx / strLen;
        var strUy = strDy / strLen;
        var divUx = divDx / divLen;
        var divUy = divDy / divLen;

        var bisectX = strUx + divUx;
        var bisectY = strUy + divUy;
        var bisectLen = Math.Sqrt(bisectX * bisectX + bisectY * bisectY);

        if (bisectLen == 0)
            return (sx, sy, 0);

        var normBisectX = bisectX / bisectLen;
        var normBisectY = bisectY / bisectLen;

        var labelX = sx + normBisectX * PointLabelOffset;
        var labelY = sy + normBisectY * PointLabelOffset;

        var angle = Math.Atan2(normBisectY, normBisectX) * 180 / Math.PI;

        if (angle > 90)
            angle -= 180;
        else if (angle < -90)
            angle += 180;

        return (labelX, labelY, angle);
    }

    private (double x, double y) ToPixelCentered(GridCoordinate coord, bool toRight)
    {
        var offset = toRight ^ IsInverted ? 0.5 : -0.5;
        return IsInverted
            ? ((Topology.MaxColumn - coord.Column + offset) * CellSize, (Topology.MaxRow - coord.Row + 1) * CellSize)
            : ((coord.Column + offset) * CellSize, coord.Row * CellSize);
    }

    private HashSet<TrackLink> FindRouteLinks(TrainRouteCommand route)
    {
        var fromSignalDef = Topology.Signals.FirstOrDefault(s => s.Name == route.FromSignal.ToString());
        var toSignalDef = Topology.Signals.FirstOrDefault(s => s.Name == route.ToSignal.ToString());
        if (fromSignalDef?.Coordinate is not { } fromCoord || toSignalDef?.Coordinate is not { } toCoord)
            return new();

        // Build list of waypoints: from → intermediates → to
        var waypoints = new List<(GridCoordinate Coord, bool DrivesRight)> { (fromCoord, fromSignalDef.DrivesRight) };
        foreach (var intermediateSignal in route.IntermediateSignals)
        {
            var sig = Topology.Signals.FirstOrDefault(s => s.Name == intermediateSignal.ToString());
            if (sig is not null)
                waypoints.Add((sig.Coordinate, sig.DrivesRight));
        }
        waypoints.Add((toCoord, toSignalDef.DrivesRight));

        // Trace each segment and combine
        var result = new HashSet<TrackLink>();
        for (var i = 0; i < waypoints.Count - 1; i++)
        {
            var segmentPath = Topology.Graph.FindRoutePath(waypoints[i].Coord, waypoints[i + 1].Coord, waypoints[i].DrivesRight, Topology.Points, route.PointCommands.ToList());
            foreach (var link in segmentPath)
                result.Add(link);
        }
        return result;
    }

    private void RecomputeActiveRouteLinks()
    {
        var union = new HashSet<TrackLink>();
        foreach (var links in _routeLinks.Values)
            union.UnionWith(links);
        _activeRouteLinks = union;
        // An overlapping stretch is shown only along a route, so the red follows the route set.
        RecomputeOccupiedLinks();
    }

    private void RecomputeActiveShuntingRouteLinks()
    {
        var union = new HashSet<TrackLink>();
        foreach (var links in _shuntingRouteLinks.Values)
            union.UnionWith(links);
        _activeShuntingRouteLinks = union;
        RecomputeOccupiedLinks();
    }

    private IReadOnlyList<ShuntingArea> ShuntingAreas =>
        YardDataService.GetStationData(StationName)?.ShuntingAreas ?? [];

    /// <summary>
    /// Collects the arm links of every point handed over to a shunter. Flank protection points
    /// are excluded: they are held in position for the area, not free for the shunter to move,
    /// so they keep the normal grey.
    /// </summary>
    private void RecomputeShuntingAreaLinks()
    {
        var links = new HashSet<TrackLink>();
        List<ShuntingArea> released = [];
        foreach (var area in ShuntingAreas)
        {
            if (ShuntingAreaService.GetState(StationName, area.Number) != ShuntingAreaState.Released) continue;
            released.Add(area);
            foreach (var pointNumber in area.ShunterPointNumbers)
                foreach (var link in FindPointArmLinks(pointNumber))
                    links.Add(link);
        }
        _shuntingAreaLinks = links;
        _releasedAreas = released;
        _releaseRequests = ShuntingAreaService.ReleaseRequests(StationName);
    }

    private IReadOnlyList<OccupancySection> OccupancySections =>
        YardDataService.GetStationData(StationName)?.OccupancySections ?? [];

    /// <summary>
    /// Resolves the station's detection stretches to the links they cover, and notes for every
    /// link every stretch covering it, shortest first — a link in a throat belongs to several
    /// stretches at once, and which of them a simulated click reports is settled by the points.
    /// </summary>
    private void RecomputeOccupancySectionLinks()
    {
        // The map only changes when a reload replaces the topology, and resolving every stretch
        // costs a shortest-path search each, so it is not worth redoing on an ordinary render.
        if (ReferenceEquals(_occupancySectionTopology, Topology))
        {
            RecomputeOccupiedLinks();
            return;
        }

        _occupancySectionTopology = Topology;
        _occupancySectionTracks = Topology.MapOccupancySectionTracks(OccupancySections);

        var covering = new Dictionary<TrackLink, List<int>>();
        foreach (var (sectionNumber, track) in _occupancySectionTracks.OrderBy(entry => entry.Value.Links.Count))
            foreach (var link in track.Links)
                (covering.TryGetValue(link, out var sections) ? sections : covering[link] = []).Add(sectionNumber);
        _simulationLinks = [.. covering.Select(entry => (Link: entry.Key, CoveringSections: (IReadOnlyList<int>)entry.Value))];

        RecomputeOccupiedLinks();
    }

    /// <summary>
    /// Which track an occupied stretch actually turns red. Stretches overlap at the points,
    /// where a detector cannot say which way through them the movement went — but the points
    /// themselves can, and they answer whether or not a route is set over them. So an occupied
    /// stretch is drawn where its points still connect it: one they are set for is drawn whole,
    /// one they are turned against keeps only what a movement could still have reached.
    /// </summary>
    private void RecomputeOccupiedLinks()
    {
        var trainNumbers = TrainNumberService.GetTrainNumbers(StationName);
        var armsTurnedAway = Topology.ArmsTurnedAway(PositionOf);
        var occupied = new HashSet<TrackLink>();

        foreach (var (sectionNumber, track) in _occupancySectionTracks)
        {
            // A train number names one stretch exactly, so there is nothing for the points to
            // resolve: the stretch a train stands on is shown whole, shared track or not. It is
            // read alongside the detector rather than written into it, so neither can erase the
            // other where a stretch has both a train number on it and a detector behind it.
            if (trainNumbers.ContainsKey(sectionNumber))
            {
                occupied.UnionWith(track.Links);
                continue;
            }
            if (!OccupancyService.IsOccupied(StationName, sectionNumber)) continue;
            occupied.UnionWith(track.ConnectedPart(armsTurnedAway));
        }

        _occupiedLinks = occupied;
        RecomputeDisplayedTrainNumbers(trainNumbers);
    }

    /// <summary>Where a point stands, by the number and sub-point letter its label carries.</summary>
    private PointPosition PositionOf(PointDefinition point)
    {
        var (number, subPoint) = GetPointNumberAndSubPoint(point.Label);
        if (number <= 0) return PointPosition.Undefined;
        return subPoint.HasValue
            ? PointPositionService.GetPosition(StationName, number, subPoint.Value)
            : PointPositionService.GetPosition(StationName, number);
    }

    /// <summary>
    /// Where every train number is written. A train stands on one stretch, but EBICOS carries its
    /// number the length of the route it is running, so the dispatcher can read off the diagram
    /// which movement each piece of track has been given to. The stretch the train actually
    /// stands on is written last, so nothing a route put there can displace it.
    /// </summary>
    private void RecomputeDisplayedTrainNumbers(IReadOnlyDictionary<int, string> trainNumbers)
    {
        var displayed = new Dictionary<int, string>();

        foreach (var (routeLinks, links) in AllActiveRouteLinks())
        {
            if (TrainRunningRoute(routeLinks.from, links, trainNumbers) is not { } trainNumber) continue;
            foreach (var sectionNumber in _occupancySectionTracks.SectionsAlongRoute(links))
                displayed[sectionNumber] = trainNumber;
        }

        foreach (var (sectionNumber, trainNumber) in trainNumbers)
            displayed[sectionNumber] = trainNumber;

        _displayedTrainNumbers = displayed;
    }

    private IEnumerable<((int from, int to), HashSet<TrackLink> Links)> AllActiveRouteLinks() =>
        _routeLinks.Concat(_shuntingRouteLinks).Concat(_cancellingRouteLinks)
            .Select(entry => (entry.Key, entry.Value));

    /// <summary>
    /// The train a route is set for: the one waiting on the stretch in front of its from signal,
    /// or, once it has moved up, the one standing on a stretch the route covers.
    /// </summary>
    private string? TrainRunningRoute(int fromSignal, IReadOnlySet<TrackLink> links, IReadOnlyDictionary<int, string> trainNumbers)
    {
        if (Topology.SectionLeadingUpTo(fromSignal, OccupancySections, _occupancySectionTracks, links) is { } approach
            && trainNumbers.TryGetValue(approach, out var waiting))
            return waiting;

        foreach (var (sectionNumber, trainNumber) in trainNumbers)
            if (_occupancySectionTracks.TryGetValue(sectionNumber, out var track)
                && track.Links.Count > 0 && track.Links.All(links.Contains))
                return trainNumber;

        return null;
    }

    /// <summary>
    /// Reports the track under a click occupied or free, standing in for the detector that is not
    /// there. Several stretches cover a link in a throat, so the one reported is the shortest the
    /// points still connect end to end — the same stretch the diagram would then draw. Clicking
    /// again frees whichever of them is reporting, so a point moved in between cannot strand one.
    /// </summary>
    private void ToggleOccupancy(IReadOnlyList<int> coveringSections)
    {
        if (coveringSections.Count == 0) return;

        // A held stretch answers the click before anything else does. It is the one indication on
        // the diagram that will not clear itself, so taking it back is what a click on it means —
        // in production, where that is the only thing these hit lines are there for, and in
        // development, where a click would otherwise report the stretch free to a detector that
        // has already said so and leave the hold standing.
        var held = coveringSections.Where(number => OccupancyHoldService.IsHeld(StationName, number)).ToList();
        if (held.Count > 0)
        {
            foreach (var number in held) OccupancyHoldService.Release(StationName, number);
            return;
        }

        if (!AllowOccupancySimulation) return;

        var reporting = coveringSections.Where(number => OccupancyService.IsOccupied(StationName, number)).ToList();
        if (reporting.Count > 0)
        {
            foreach (var number in reporting) OccupancyService.SetOccupied(StationName, number, false);
            return;
        }

        var armsTurnedAway = Topology.ArmsTurnedAway(PositionOf);
        OccupancyService.SetOccupied(StationName, coveringSections.FirstOrDefault(IsConnected, coveringSections[0]), true);

        bool IsConnected(int sectionNumber) =>
            _occupancySectionTracks.TryGetValue(sectionNumber, out var track)
            && !track.Links.Any(armsTurnedAway.Contains);
    }

    /// <summary>
    /// Caches what the tap gestures need from the station's route table: the points to resolve
    /// slave cascades with, and the signals no other signal follows — the ones that end a
    /// movement, because no route starts at them and none passes through them.
    /// </summary>
    private void RecomputeStationLookups()
    {
        var data = YardDataService.GetStationData(StationName);
        _pointsByNumber = data?.Points.ToDictionary(point => point.Number) ?? [];

        IReadOnlyList<TrainRouteCommand> routes = data?.TrainRoutes ?? [];
        var followed = new HashSet<int>();
        var destinations = new HashSet<int>();
        foreach (var route in routes)
        {
            followed.Add(route.FromSignal);
            foreach (var signalNumber in route.IntermediateSignals) followed.Add(signalNumber);
            destinations.Add(route.ToSignal);
        }
        destinations.ExceptWith(followed);
        _terminalSignals = destinations;
    }

    /// <summary>
    /// The two arm links of every point definition carrying the given number. Paired points
    /// such as 1a/1b share a number, so both halves of a crossover are returned.
    /// </summary>
    private IEnumerable<TrackLink> FindPointArmLinks(int pointNumber)
    {
        foreach (var point in Topology.Points)
        {
            if (GetPointNumberAndSubPoint(point.Label).Number != pointNumber) continue;
            var straight = Topology.Graph.GetLink(point.SwitchPoint, Topology.Graph.DeduceStraightArm(point));
            if (straight is not null) yield return straight;
            var diverging = Topology.Graph.GetLink(point.SwitchPoint, Topology.Graph.DeduceDivergingEnd(point));
            if (diverging is not null) yield return diverging;
        }
    }

    private void RecomputeCancellingRouteLinks()
    {
        var union = new HashSet<TrackLink>();
        foreach (var links in _cancellingRouteLinks.Values)
            union.UnionWith(links);
        _activeCancellingRouteLinks = union;
        RecomputeOccupiedLinks();
    }

    /// <summary>
    /// Finds a link that would contain the specified coordinate (between its endpoints).
    /// For example, coordinate 2.1 would be found on link 2.0-2.2.
    /// </summary>
    private TrackLink? FindLinkContaining(GridCoordinate coord)
    {
        foreach (var link in Topology.Graph.Links)
        {
            var from = link.FromNode.Coordinate;
            var to = link.ToNode.Coordinate;

            // Check if coord is on the line between from and to
            // Same row, column between from and to
            if (from.Row == to.Row && coord.Row == from.Row)
            {
                var minCol = Math.Min(from.Column, to.Column);
                var maxCol = Math.Max(from.Column, to.Column);
                if (coord.Column > minCol && coord.Column < maxCol)
                    return link;
            }
            // Same column, row between from and to
            else if (from.Column == to.Column && coord.Column == from.Column)
            {
                var minRow = Math.Min(from.Row, to.Row);
                var maxRow = Math.Max(from.Row, to.Row);
                if (coord.Row > minRow && coord.Row < maxRow)
                    return link;
            }
            // Diagonal - check if point is on line segment
            else
            {
                var dx = to.Column - from.Column;
                var dy = to.Row - from.Row;
                var px = coord.Column - from.Column;
                var py = coord.Row - from.Row;

                // Check if point is on line (cross product = 0) and between endpoints
                if (dx * py == dy * px) // On the line
                {
                    var t = dx != 0 ? (double)px / dx : (double)py / dy;
                    if (t > 0 && t < 1)
                        return link;
                }
            }
        }
        return null;
    }

}
