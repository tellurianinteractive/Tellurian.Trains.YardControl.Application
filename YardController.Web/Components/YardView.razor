@using Tellurian.Trains.YardController.Model
@using Tellurian.Trains.YardController.Model.Control
@using Tellurian.Trains.YardController.Model.Control.Extensions
@using YardController.Web.Resources
@using YardController.Web.Services
@using System.Globalization
@inject IBufferedKeyReader BufferedKeyReader
@inject ITrainRouteNotificationService TrainRouteNotifications
@inject IPointPositionService PointPositionService
@inject ISignalStateService SignalStateService
@inject IYardDataService YardDataService
@inject IYardController YardController
@inject IPointNotificationService PointNotifications
@inject TrainRouteLockingsManager LockingsManager
@inject ITrainNumberService TrainNumberService
@inject IShuntingAreaService ShuntingAreaService
@inject IOccupancySectionService OccupancyService
@inject IOccupancyHoldService OccupancyHoldService
@inject IEntryStateService EntryStateService
@implements IDisposable

<svg viewBox="0 0 @ViewBoxWidth @TotalViewBoxHeight" class="yard-view" xmlns="http://www.w3.org/2000/svg" style="user-select: none;">
    <!-- Background -->
    <rect fill="@EbicosColours.Background" width="100%" height="100%"/>

    <!-- Station name -->
    @if (!string.IsNullOrEmpty(Topology.Name))
    {
        @((MarkupString)$"""
            <text
                x="{ViewBoxWidth / 2}"
                y="{TitleFontSize}"
                text-anchor="middle"
                fill="{EbicosColours.White}"
                font-size="{TitleFontSize}"
                font-family="sans-serif"
                font-weight="bold">
                {System.Web.HttpUtility.HtmlEncode(TranslateLabel(Topology.Name))}
            </text>
            """)
    }

    <!-- Grid (for debugging/alignment) -->
    @if (ShowGrid)
    {
        <g id="grid" stroke="@EbicosColours.GridLine" stroke-width="0.5">
            @for (int col = 0; col <= Topology.MaxColumn; col++)
            {
                var x = col * CellSize;
                <line x1="@x" y1="0" x2="@x" y2="@ViewBoxHeight" />
            }
            @for (int row = 0; row <= Topology.MaxRow + 1; row++)
            {
                var y = row * CellSize;
                <line x1="0" y1="@y" x2="@ViewBoxWidth" y2="@y" />
            }
        </g>
        <g id="grid-labels">
            @for (int col = 0; col <= Topology.MaxColumn; col++)
            {
                @((MarkupString)$"""
                    <text x="{col * CellSize}" y="{GridLabelFontSize}"
                          font-size="{GridLabelFontSize}" font-family="sans-serif"
                          fill="{EbicosColours.GridLabel}" text-anchor="middle" dominant-baseline="central">{col}</text>
                    """)
            }
            @for (int row = 0; row <= Topology.MaxRow; row++)
            {
                @((MarkupString)$"""
                    <text x="{GridLabelFontSize}" y="{row * CellSize}"
                          font-size="{GridLabelFontSize}" font-family="sans-serif"
                          fill="{EbicosColours.GridLabel}" text-anchor="end" dominant-baseline="central">{row}</text>
                    """)
            }
        </g>
    }

    <!-- Platforms. A platform is where passengers stand, not track a train runs over, so it is
         drawn as a band beside the rails rather than on them: half again as wide as the track,
         a shade darker than free track, and standing clear of it by a gap. It carries no state
         and never changes colour, so it lies under every other layer and nothing on the diagram
         ends up hidden behind it. -->
    <g id="platforms" stroke-width="@F(PlatformWidth)" fill="none" stroke-linecap="butt">
        @foreach (var platform in Topology.Platforms)
        {
            var (fromX, fromY) = ToPixel(platform.From);
            var (toX, toY) = ToPixel(platform.To);
            var (offsetX, offsetY) = PlatformOffset(fromX, fromY, toX, toY, platform.Side);
            <line x1="@F(fromX + offsetX)" y1="@F(fromY + offsetY)"
                  x2="@F(toX + offsetX)" y2="@F(toY + offsetY)"
                  stroke="@EbicosColours.Platform" />
        }
    </g>

    <!-- Track links, coloured by TRVINFRA-00305 6.2.1: free track grey, part of a released
         shunting area blue, route being released magenta, shunting route yellow, train route
         green, occupied red. The values are the exact ones the specification's own specimen
         images use, so track and signal symbols share one palette. The loops run in reverse
         priority order, each painting over the last: blue sits directly above grey (6.2.1
         priority 7, 6.2.12 priority 9) so any route colour wins over it, and an occupied
         detection stretch is priority 2, above every route colour — where a train stands, the
         diagram says so before it says what the track was set for. -->
    <g id="tracks" stroke-width="@TrackThickness" fill="none" stroke-linecap="round">
        @foreach (var link in Topology.Graph.Links.Where(l => !_activeRouteLinks.Contains(l) && !_activeShuntingRouteLinks.Contains(l) && !_activeCancellingRouteLinks.Contains(l) && !_shuntingAreaLinks.Contains(l)))
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Grey" />
        }
        @foreach (var link in _shuntingAreaLinks.Where(l => !_activeRouteLinks.Contains(l) && !_activeShuntingRouteLinks.Contains(l) && !_activeCancellingRouteLinks.Contains(l)))
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Blue" />
        }
        @foreach (var link in _activeCancellingRouteLinks.Where(l => !_activeRouteLinks.Contains(l) && !_activeShuntingRouteLinks.Contains(l)))
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Magenta" />
        }
        @foreach (var link in _activeShuntingRouteLinks)
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Yellow" />
        }
        @foreach (var link in _activeRouteLinks)
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Green" />
        }
        @foreach (var link in _occupiedLinks)
        {
            var (x1, y1) = ToPixel(link.FromNode.Coordinate);
            var (x2, y2) = ToPixel(link.ToNode.Coordinate);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="@EbicosColours.Red" />
        }
    </g>

    <!-- A stretch held occupied after its detector let go stays red, because it is occupied: the
         wagons the loco left behind are standing on it and §6.2.1 has one colour for that. What
         the mark adds is that this indication will not clear itself. It is magenta, the colour
         this diagram already gives to everything the interlocking is holding until someone acts. -->
    <g id="occupancy-holds" fill="@EbicosColours.Magenta" stroke="@EbicosColours.Background" stroke-width="1">
        @foreach (var sectionNumber in _heldSections)
        {
            @if (SectionLabelAnchor(sectionNumber) is { } anchor)
            {
                <circle cx="@anchor.X" cy="@anchor.Y" r="@HoldMarkerRadius" />
            }
        }
    </g>

    @if (AllowOccupancySimulation || _heldSections.Count > 0)
    {
        <!-- In development there is no detector behind the diagram, so clicking a stretch reports
             it occupied or free. One hit line per track link, carrying every stretch that covers
             it, because the stretches overlap where the track branches; which of them the click
             reports is settled by the points, the way a detector's report is.
             The same hit lines answer in production while a stretch is being held: a held
             indication is the one thing on the diagram an operator has to take back by hand, so
             it must be reachable by a click whether or not the simulation is on.
             It lies under the point and signal layers, so their taps still win. -->
        <g id="occupancy-simulation" stroke="transparent" stroke-width="@(TrackThickness + 4)"
           fill="none" stroke-linecap="butt" pointer-events="stroke" style="cursor: pointer;">
            @foreach (var (link, coveringSections) in _simulationLinks)
            {
                var (x1, y1) = ToPixel(link.FromNode.Coordinate);
                var (x2, y2) = ToPixel(link.ToNode.Coordinate);
                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" @onclick="() => ToggleOccupancy(coveringSections)" />
            }
        </g>
    }

    <!-- Features layer (on top of tracks) -->

    <!-- Gaps (occupancy dividers). EBICOS draws a track section boundary as a break in the
         line rather than a coloured mark, so these are painted in the background colour over
         the track. Orange is reserved by 6.2.1 for hump routes. -->
    <g id="gaps">
        @foreach (var gap in Topology.Gaps)
        {
            @if (gap.LinkEnd.HasValue)
            {
                // Explicit link gap - render at midpoint of specified link
                var (x1, y1) = ToPixel(gap.Coordinate);
                var (x2, y2) = ToPixel(gap.LinkEnd.Value);
                var midX = (x1 + x2) / 2.0;
                var midY = (y1 + y2) / 2.0;

                var dx = x2 - x1;
                var dy = y2 - y1;
                var len = Math.Sqrt(dx * dx + dy * dy);
                if (len > 0)
                {
                    var perpX = -dy / len;
                    var perpY = dx / len;
                    var g1X = midX + perpX * GapSize;
                    var g1Y = midY + perpY * GapSize;
                    var g2X = midX - perpX * GapSize;
                    var g2Y = midY - perpY * GapSize;

                    <line x1="@F(g1X)" y1="@F(g1Y)" x2="@F(g2X)" y2="@F(g2Y)"
                          stroke="@EbicosColours.Background" stroke-width="@GapWidth" stroke-linecap="butt" />
                }
            }
            else
            {
                // Node gap - find the link containing this coordinate
                var containingLink = FindLinkContaining(gap.Coordinate);
                var (x, y) = ToPixel(gap.Coordinate);

                if (containingLink != null)
                {
                    // Render gap as perpendicular line on the containing link
                    var (x1, y1) = ToPixel(containingLink.FromNode.Coordinate);
                    var (x2, y2) = ToPixel(containingLink.ToNode.Coordinate);

                    var dx = x2 - x1;
                    var dy = y2 - y1;
                    var len = Math.Sqrt(dx * dx + dy * dy);
                    if (len > 0)
                    {
                        var perpX = -dy / len;
                        var perpY = dx / len;
                        var g1X = x + perpX * GapSize;
                        var g1Y = y + perpY * GapSize;
                        var g2X = x - perpX * GapSize;
                        var g2Y = y - perpY * GapSize;

                        <line x1="@F(g1X)" y1="@F(g1Y)" x2="@F(g2X)" y2="@F(g2Y)"
                              stroke="@EbicosColours.Background" stroke-width="@GapWidth" stroke-linecap="butt" />
                    }
                }
                else
                {
                    // No containing link found - draw vertical line as default gap indicator
                    <line x1="@x" y1="@F(y - GapSize)" x2="@x" y2="@F(y + GapSize)"
                          stroke="@EbicosColours.Background" stroke-width="@GapWidth" stroke-linecap="butt" />
                }
            }
        }
    </g>

    <!-- Points (labels and position indicators) -->
    <g id="points">
        @foreach (var point in Topology.Points)
        {
            var (sx, sy) = ToPixel(point.SwitchPoint);
            var divergingEnd = Topology.Graph.DeduceDivergingEnd(point);
            var (divX, divY) = ToPixel(divergingEnd);

            // Deduce straight arm for label positioning
            var straightEnd = Topology.Graph.DeduceStraightArm(point);
            var (strX, strY) = ToPixel(straightEnd);

            // Calculate label position at bisector between straight and diverging
            var (labelX, labelY, labelAngle) = CalculatePointLabelPosition(sx, sy, strX, strY, divX, divY);

            <g class="point" id="point-@point.Label">
                @{
                    var lx = F(labelX);
                    var ly = F(labelY);
                    var la = F(labelAngle);
                }
                @((MarkupString)$"""
                    <text
                        x="{lx}"
                        y="{ly}"
                        text-anchor="middle"
                        dominant-baseline="central"
                        fill="{EbicosColours.Magenta}"
                        font-size="{PointLabelFontSize}"
                        font-family="sans-serif"
                        font-weight="bold"
                        transform="rotate({la} {lx} {ly})">
                        {System.Web.HttpUtility.HtmlEncode(point.Label)}
                    </text>
                    """)
                <rect x="@F(labelX - PointHitWidth / 2)" y="@F(labelY - PointHitHeight / 2)"
                      width="@PointHitWidth" height="@PointHitHeight"
                      transform="rotate(@la @lx @ly)"
                      fill="none" pointer-events="all" class="point-hit"
                      @onclick="() => OnPointClicked(point.Label)" />
                @{
                    var position = PositionOf(point);
                }
                @if (position != PointPosition.Undefined)
                {
                    // The arm the point is turned away from is the one that is closed, and the
                    // cut across it runs parallel to the explicit end, which the topology always
                    // spells as the diagonal arm.
                    var (inactiveX, inactiveY) = position == PointPosition.Straight ? (divX, divY) : (strX, strY);
                    var (expX, expY) = ToPixel(point.ExplicitEnd);

                    @if (PointCutOff(sx, sy, inactiveX, inactiveY, expX - sx, expY - sy) is { } pts)
                    {
                        <polygon points="@pts" fill="@EbicosColours.Background" />
                    }
                }
            </g>
        }
    </g>

    <!-- Plain crossings. Nothing on one moves, so which of its ways is open is read off the
         points leading into it: the arms of a way whose point is turned elsewhere are closed,
         and with both points turned away the crossing is cut off on all four sides. -->
    <g id="crossings">
        @foreach (var crossing in Topology.Crossings)
        {
            var (cx, cy) = ToPixel(crossing.Coordinate);
            var arms = crossing.Ways.Select(way => (Way: way, Arms: Topology.ArmsOf(crossing, way))).ToList();

            @foreach (var (way, wayArms) in arms)
            {
                // Only a position actually reported closes an arm. A point nothing has reported
                // yet leaves its way undrawn, exactly as an undefined point draws no gap.
                var governing = PointPositionService.GetPosition(StationName, way.Governing.Number);
                @if (governing == PointPosition.Undefined || governing == way.Governing.Position) { continue; }

                // The cut runs parallel to the other way through the crossing — which at a plain
                // crossing is the very track that passes over the closed one.
                var across = arms.FirstOrDefault(other => other.Way != way).Arms ?? [];
                @if (across.Count == 0) { continue; }
                var (acrossX, acrossY) = ToPixel(OtherEnd(across[0], crossing.Coordinate));

                @foreach (var arm in wayArms)
                {
                    var (armX, armY) = ToPixel(OtherEnd(arm, crossing.Coordinate));
                    @if (CrossingCutOff(cx, cy, armX, armY, acrossX - cx, acrossY - cy) is { } pts)
                    {
                        <polygon points="@pts" fill="@EbicosColours.Background" />
                    }
                }
            }
        }
    </g>

    <!-- Signals (excluding hidden) -->
    <g id="signals">
        @foreach (var signalDef in Topology.Signals.Where(s => s.IsVisible))
        {
            <SignalView Data="@GetSignal(signalDef)" CellSize="@CellSize"
                        TrackThickness="@TrackThickness"
                        Aspect="@GetSignalAspect(signalDef)"
                        TrackAngle="@TrackAngleAt(signalDef)"
                        IsSelected="@(_selectedFromSignal == signalDef.Name)"
                        IsCandidate="@IsEntryCandidate(signalDef.Name)"
                        IsInverted="@IsInverted"
                        MaxColumn="@Topology.MaxColumn" MaxRow="@Topology.MaxRow"
                        OnSignalClicked="OnSignalClicked" />
        }
    </g>

    <!-- Train numbers. A train number stands on a detection stretch — the piece of track a train
         can be on — so it is written along that stretch, clear of the track, in a monospaced
         face padded out to five digits so a column of them lines up. EBICOS repeats it the length
         of the route the train is running, and each copy wears the colour of the stretch it
         stands on. They share the upper text lane with signal numbers.
         The label lies over one straight run of the stretch and is turned to that run's angle, so
         it runs with the rails instead of across them: level wherever the stretch has a level run,
         and at 45° where it has none. The rotation is written out even where it turns nothing,
         so every number is placed the one way. -->
    <g id="train-numbers">
        @foreach (var (sectionNumber, trainNumber) in _displayedTrainNumbers)
        {
            if (SectionLabelAnchor(sectionNumber) is not { } anchor) continue;
            var (labelX, labelY) = TrainNumberBaseline(anchor);

            @((MarkupString)$"""
                <text
                    x="{F(labelX)}"
                    y="{F(labelY)}"
                    transform="rotate({F(anchor.Angle)} {F(labelX)} {F(labelY)})"
                    text-anchor="middle"
                    fill="{TrainNumberColour(sectionNumber)}"
                    font-size="{TrainNumberFontSize}"
                    font-family="{TrainNumberDisplay.FontFamily}"
                    font-weight="bold">
                    {System.Web.HttpUtility.HtmlEncode(TrainNumberDisplay.Format(trainNumber))}
                </text>
                """)
        }
    </g>

    <!-- Labels -->
    <g id="labels" font-size="@FontSize" font-family="sans-serif">
        @foreach (var label in Topology.Labels)
        {
            var (x1, y1) = ToPixel(label.Start);
            var (x2, y2) = ToPixel(label.End);
            var x = (x1 + x2) / 2.0;
            var y = (y1 + y2) / 2.0;
            var displayText = TranslateLabel(label.Text);

            // A short label is a track number rather than a name, and reads as a heading over the
            // track it belongs to, so it is drawn at twice the size.
            var fontSize = displayText.Length <= ShortLabelMaxLength ? FontSize * 2 : FontSize;

            // The label lies over the track, so the ground behind it is painted out to keep the
            // words readable. Only the text needs clearing, not the whole stretch its coordinates
            // span, so the patch is the width of the glyphs plus a little air on either side.
            // The one thing behind the text is the track line, so the patch is only as tall as
            // that line: a patch the height of the glyphs would reach past the gap beside the
            // track and cut a notch out of any platform running there.
            var patchWidth = EstimatedTextWidth(displayText, fontSize) + LabelBackgroundPadding * 2;
            var patchHeight = TrackThickness + 2.0;

            @((MarkupString)$"""
                <rect
                    x="{F(x - patchWidth / 2)}"
                    y="{F(y - patchHeight / 2)}"
                    width="{F(patchWidth)}"
                    height="{F(patchHeight)}"
                    fill="{EbicosColours.Background}" />
                <text
                    x="{F(x)}"
                    y="{F(y)}"
                    font-size="{F(fontSize)}"
                    text-anchor="middle"
                    dominant-baseline="central"
                    fill="{EbicosColours.White}">
                    {System.Web.HttpUtility.HtmlEncode(displayText)}
                </text>
                """)
        }
    </g>

    <!-- Status message below grid -->
    <text
        x="@(ViewBoxWidth / 2)"
        y="@(ViewBoxHeight + TitleFontSize + 8)"
        text-anchor="middle"
        fill="@StatusTextColor"
        font-size="@TitleFontSize"
        font-family="sans-serif"
        font-weight="bold">
        @StatusText
    </text>
    @{
        // The list can hold routes of both kinds, so each entry is drawn in the colour of the
        // route it is waiting to become; the heading itself regards no single object and stays grey.
        var queuedLabel = System.Web.HttpUtility.HtmlEncode($"{Messages.QueuedRoutes}:");
        var queuedEntries = string.Join(", ", _queuedRoutes.Select(q =>
            $"""<tspan fill="{(q.State.IsShunting ? EbicosColours.Yellow : EbicosColours.Green)}">{System.Web.HttpUtility.HtmlEncode(FormatQueuedRoute(q.FromSignal, q.ToSignal, q.TrainNumber))}</tspan>"""));
        var queuedText = _queuedRoutes.Count > 0 ? $"{queuedLabel} {queuedEntries}" : queuedLabel;
    }
    @((MarkupString)$"""<text x="{ViewBoxWidth / 2}" y="{ViewBoxHeight + (TitleFontSize + 8) * 2}" text-anchor="middle" fill="{EbicosColours.Grey}" font-size="{TitleFontSize - 2}" font-family="sans-serif">{queuedText}</text>""")
    @* Razor reserves <text> inside a code block, so this line is always rendered and simply
       carries no text when no shunter is waiting. *@
    <text
        x="@(ViewBoxWidth / 2)"
        y="@(ViewBoxHeight + (TitleFontSize + 8) * 3)"
        text-anchor="middle"
        fill="@EbicosColours.Blue"
        font-size="@(TitleFontSize - 2)"
        font-family="sans-serif"
        class="@(_releaseRequests.Count > 0 ? "release-request" : "")">
        @ReleaseRequestText
    </text>
    @* What is about to happen, character by character, for both input devices (§8). The line
       wears the colour of whatever the command regards, the same rule the status line follows. *@
    <text
        x="@(ViewBoxWidth / 2)"
        y="@(ViewBoxHeight + (TitleFontSize + 8) * 4)"
        text-anchor="middle"
        fill="@SubjectColour(EntrySubject)"
        font-size="@(TitleFontSize - 2)"
        font-family="sans-serif">
        @_entry.DisplayText
    </text>
</svg>

@code {
    [Parameter, EditorRequired]
    public YardTopology Topology { get; set; } = YardTopology.Empty;

    [Parameter]
    public int CellSize { get; set; } = 40;

    [Parameter]
    public int TrackThickness { get; set; } = 6;

    [Parameter]
    public bool ShowGrid { get; set; } = true;

    [Parameter]
    public bool IsInverted { get; set; }

    [Parameter]
    public string StationName { get; set; } = "";

    [Parameter]
    public LabelTranslator? LabelTranslator { get; set; }

    /// <summary>
    /// Who is looking at the yard. The dispatcher works everything the interlocking owns; the
    /// shunter works only the released shunting areas. Every command carries the role, so the
    /// input pipeline — not the view alone — decides what is permitted.
    /// </summary>
    [Parameter]
    public OperatorRole Role { get; set; }

    /// <summary>
    /// Lets a click on a track report the stretch under it occupied or free. For development,
    /// where no detector is connected and the diagram would otherwise never show red.
    /// </summary>
    [Parameter]
    public bool AllowOccupancySimulation { get; set; }

    private string? _selectedFromSignal;
    private string? _pendingClearSignal;
    private System.Threading.Timer? _pendingClearTimer;
    private string? _feedbackMessage;
    private StatusSubject _feedbackSubject = StatusSubject.None;
    private System.Threading.Timer? _feedbackTimer;
    private readonly Dictionary<(int from, int to), HashSet<TrackLink>> _routeLinks = new();
    private readonly Dictionary<(int from, int to), HashSet<TrackLink>> _shuntingRouteLinks = new();
    private readonly Dictionary<(int from, int to), HashSet<TrackLink>> _cancellingRouteLinks = new();
    private HashSet<TrackLink> _activeRouteLinks = new();
    private HashSet<TrackLink> _activeShuntingRouteLinks = new();
    private HashSet<TrackLink> _activeCancellingRouteLinks = new();
    private HashSet<TrackLink> _shuntingAreaLinks = new();
    private YardTopology? _occupancySectionTopology;
    private IReadOnlyDictionary<int, OccupancySectionTrack> _occupancySectionTracks = new Dictionary<int, OccupancySectionTrack>();
    private IReadOnlyList<(TrackLink Link, IReadOnlyList<int> CoveringSections)> _simulationLinks = [];
    private HashSet<TrackLink> _occupiedLinks = new();
    private IReadOnlyList<int> _heldSections = [];
    private IReadOnlyDictionary<int, string> _displayedTrainNumbers = new Dictionary<int, string>();
    private IReadOnlyList<ShuntingArea> _releasedAreas = [];
    private HashSet<int> _terminalSignals = [];
    private Dictionary<int, Point> _pointsByNumber = [];
    private IReadOnlyList<int> _releaseRequests = [];
    private readonly List<(int FromSignal, int ToSignal, string? TrainNumber, TrainRouteState State)> _queuedRoutes = [];

    protected override void OnInitialized()
    {
        TrainRouteNotifications.RouteChanged += OnRouteChanged;
        PointNotifications.PointChanged += OnPointChanged;
        PointPositionService.PositionChanged += OnPointPositionChanged;
        SignalStateService.SignalStateChanged += OnSignalStateChanged;
        TrainNumberService.TrainNumberChanged += OnTrainNumberChanged;
        ShuntingAreaService.ShuntingAreaChanged += OnShuntingAreaChanged;
        ShuntingAreaService.ReleaseRequestChanged += OnReleaseRequestChanged;
        OccupancyService.OccupancyChanged += OnOccupancyChanged;
        OccupancyHoldService.HoldChanged += OnOccupancyHoldChanged;
        EntryStateService.EntryChanged += OnEntryChanged;
        var entry = EntryStateService.GetEntry(StationName);
        if (entry.Role == Role) _entry = entry;
        _heldSections = OccupancyHoldService.HeldSections(StationName);
        RecomputeShuntingAreaLinks();
        RecomputeStationLookups();
        RecomputeOccupancySectionLinks();

        // Restore route links from surviving singleton state (e.g. after language change page reload)
        foreach (var route in LockingsManager.GetForStation(StationName).CurrentRoutes)
        {
            var links = FindRouteLinks(route);
            if (links.Count > 0)
            {
                if (route.State == TrainRouteState.SetShunting)
                    _shuntingRouteLinks[(route.FromSignal, route.ToSignal)] = links;
                else
                    _routeLinks[(route.FromSignal, route.ToSignal)] = links;
            }
        }
        if (_routeLinks.Count > 0)
            RecomputeActiveRouteLinks();
        if (_shuntingRouteLinks.Count > 0)
            RecomputeActiveShuntingRouteLinks();
    }

    /// <summary>A data-file reload replaces the graph, so the cached links must be rebuilt against it.</summary>
    protected override void OnParametersSet()
    {
        // Holds are kept per station, so switching station brings a different set of them.
        _heldSections = OccupancyHoldService.HeldSections(StationName);
        RecomputeShuntingAreaLinks();
        RecomputeStationLookups();
        RecomputeOccupancySectionLinks();
    }

    private void OnPointPositionChanged(PointPositionFeedback feedback)
    {
        // Only re-render for feedback belonging to this station
        if (!feedback.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;

        // A point that moves changes which of the overlapping stretches through the throat is
        // the one the detector is reporting, so the red has to be worked out again.
        InvokeAsync(() =>
        {
            RecomputeOccupiedLinks();
            StateHasChanged();
        });
    }

    private void OnSignalStateChanged(SignalStateFeedback feedback)
    {
        // Only re-render for feedback belonging to this station
        if (!feedback.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;
        InvokeAsync(StateHasChanged);
    }

    private void OnOccupancyChanged(OccupancyFeedback feedback)
    {
        if (!feedback.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;

        InvokeAsync(() =>
        {
            RecomputeOccupiedLinks();
            StateHasChanged();
        });
    }

    /// <summary>
    /// A stretch taken up or let go by hand. The colour is worked out again as for any occupancy
    /// change, since a hold is what keeps a stretch red once its detector has gone quiet, and the
    /// held list is what puts the mark on it and what makes the release click reachable.
    /// </summary>
    private void OnOccupancyHoldChanged(OccupancyHoldFeedback feedback)
    {
        if (!feedback.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;

        InvokeAsync(() =>
        {
            _heldSections = OccupancyHoldService.HeldSections(StationName);
            RecomputeOccupiedLinks();
            StateHasChanged();
        });
    }

    private void OnTrainNumberChanged(TrainNumberChanged change)
    {
        if (!change.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;

        InvokeAsync(() =>
        {
            RecomputeOccupiedLinks();
            StateHasChanged();
        });
    }

    private void OnShuntingAreaChanged(ShuntingAreaFeedback feedback)
    {
        if (!feedback.StationName.Equals(StationName, StringComparison.OrdinalIgnoreCase)) return;

        InvokeAsync(() =>
        {
            RecomputeShuntingAreaLinks();
