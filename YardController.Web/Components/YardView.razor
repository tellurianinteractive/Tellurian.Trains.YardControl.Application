        InvokeAsync(() =>
        {
            _releaseRequests = ShuntingAreaService.ReleaseRequests(StationName);
            var name = AreaDisplayName(feedback.AreaNumber);
            SetFeedback(
                string.Format(feedback.IsRequested ? Messages.ShuntingAreaReleaseRequested : Messages.ShuntingAreaRequestWithdrawn, name),
                StatusSubject.ShuntingArea);
