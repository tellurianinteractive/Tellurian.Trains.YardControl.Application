@page "/"
@page "/{Station}"
@page "/{Station}/{View}"
@rendermode InteractiveServer
@using YardController.Web.Services
@using YardController.Web.Resources
@using Tellurian.Trains.YardController.Model
@using Tellurian.Trains.YardController.Model.Control
@inject IYardDataService YardDataService
@inject IYardController YardController
@inject IBufferedKeyReader KeyReader
@inject IShuntingAreaService ShuntingAreaService
@inject KeyboardCaptureService KeyboardCapture
@inject NavigationManager Navigation
@inject IHostEnvironment HostEnvironment
@implements IAsyncDisposable

<PageTitle>@(_labelTranslator.Translate(_topology.Name, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName))</PageTitle>

<div class="yard-container">
    @if (_role == OperatorRole.Shunter)
    {
        @* The shunter has no keyboard, so asking for an area and handing it back are buttons. *@
        <div class="area-bar">
            @foreach (var area in ShuntingAreas)
            {
                var isReleased = ShuntingAreaService.GetState(_stationName, area.Number) == ShuntingAreaState.Released;
                var isRequested = ShuntingAreaService.IsReleaseRequested(_stationName, area.Number);
                <div class="area-chip @(isReleased ? "released" : isRequested ? "requested" : "")">
                    <span class="area-name">@area.Number @Translate(area.Name)</span>
                    @if (isReleased)
                    {
                        <button class="area-button" @onclick="() => HandBackArea(area.Number)">@Messages.HandBackShuntingArea</button>
                    }
                    else if (isRequested)
                    {
                        <button class="area-button" @onclick="() => RequestArea(area.Number, false)">@Messages.WithdrawShuntingAreaRequest</button>
                    }
                    else
                    {
                        <button class="area-button" @onclick="() => RequestArea(area.Number, true)">@Messages.RequestShuntingArea</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @* A numeric keypad has no A, so the dispatcher answers a request with buttons. The bar
           holds only the areas being asked for and is absent the rest of the time. *@
        var requested = ShuntingAreas
            .Where(a => ShuntingAreaService.IsReleaseRequested(_stationName, a.Number))
            .ToList();
        if (requested.Count > 0)
        {
            <div class="area-bar">
                @foreach (var area in requested)
                {
                    <div class="area-chip requested">
                        <span class="area-name">@area.Number @Translate(area.Name)</span>
                        <button class="area-button" @onclick="() => AcceptArea(area.Number)">@Messages.AcceptShuntingAreaRequest</button>
                        <button class="area-button" @onclick="() => RejectArea(area.Number)">@Messages.RejectShuntingAreaRequest</button>
                    </div>
                }
            </div>
        }
    }

    @* Without hardware there is no detector to report occupancy, so in development a click on
       a track stands in for one. *@
    <YardView Topology="_topology" StationName="@_stationName" CellSize="40" ShowGrid="_showGrid" IsInverted="_invertView" LabelTranslator="_labelTranslator" Role="_role" AllowOccupancySimulation="HostEnvironment.IsDevelopment()" />

    <footer>
        @if (_role == OperatorRole.Dispatcher)
        {
            <button class="footer-button emergency-button" @onclick="SetAllSignalsRedAsync">@Messages.AllSignalsStop</button>
        }
        <label>
            <input type="checkbox" @bind="_showGrid" /> @Messages.ShowGrid
        </label>
        <label>
            <input type="checkbox" @bind="_invertView" /> @Messages.InvertView
        </label>
        @if (_role == OperatorRole.Dispatcher)
        {
            <span class="hint">@Messages.EditDataFilesHint</span>
        }
        <span class="spacer"></span>
        <button class="footer-button" @onclick="SwitchView">
            @(_role == OperatorRole.Shunter ? Messages.DispatcherView : Messages.ShunterView)
        </button>
        @if (_role == OperatorRole.Dispatcher)
        {
            <button class="footer-button" @onclick="QueryPointStatesAsync" disabled="@_isBusy">@Messages.QueryPointStates</button>
            <button class="footer-button" @onclick="ResetAllPointsAsync">@Messages.ResetAllPoints</button>
        }
        <LanguageSelector />
    </footer>
</div>

<style>
    .yard-container {
        display: flex;
        flex-direction: column;
        /* iOS Safari counts 100vh with the toolbars retracted, so the footer ends up below
           the visible area of an iPad and there is no scrolling to reach it. */
        height: 100vh;
        height: 100dvh;
        background: #111;
        color: #ccc;
        overflow: hidden;
    }

    .area-bar {
        flex: none;
        padding: 8px 20px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .area-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 10px 6px 14px;
        border: 1px solid #555;
        border-radius: 20px;
        background: #222;
        font-size: 0.95rem;
    }

    .area-chip.released {
        border-color: #0000FF;
        color: #99bbff;
    }

    .area-chip.requested {
        border-color: #0000FF;
        color: #99bbff;
        animation: area-requested-blink 1.4s steps(1, end) infinite;
    }

    @@keyframes area-requested-blink {
        0%, 60% {
            opacity: 1;
        }

        61%, 100% {
            opacity: 0.45;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .area-chip.requested {
            animation: none;
        }
    }

    .area-name {
        font-weight: bold;
    }

    .area-button {
        padding: 8px 18px;
        background: #333;
        color: #ddd;
        border: 1px solid #666;
        border-radius: 16px;
        cursor: pointer;
        font-size: 0.95rem;
    }

    .area-button:hover {
        background: #444;
    }

    .yard-view {
        flex: 1 1 0;
        width: 100%;
        min-height: 0;
    }

    footer {
        /* The bars keep their own height whatever the diagram wants, so the row of buttons
           is never the thing that gets squeezed out. env() covers a home-screen install,
           where the bottom inset is the home indicator rather than browser chrome. */
        flex: none;
        padding: 4px 12px calc(6px + env(safe-area-inset-bottom, 0px));
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.9rem;
    }

    footer label {
        display: flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

    footer .hint {
        color: #666;
        font-style: italic;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /* On a tablet the row must fit on one line, and the hint is the one thing on it
       that says nothing about the yard. */
    @@media (max-width: 1200px) {
        footer .hint {
            display: none;
        }
    }

    footer .spacer {
        flex: 1;
    }

    footer .footer-button {
        padding: 6px 14px;
        background: #333;
        color: #ccc;
        border: 1px solid #555;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    footer .footer-button:hover:not(:disabled) {
        background: #444;
    }

    footer .footer-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    footer .emergency-button {
        background: #cc0000;
        color: white;
        border-color: #ff3333;
        font-weight: bold;
    }

    footer .emergency-button:hover:not(:disabled) {
        background: #ee0000;
    }
</style>

@code {
    [Parameter]
    public string? Station { get; set; }

    /// <summary>
    /// Which of the station's two views to show: <c>shunter</c> for the shunting yard master,
    /// anything else — including nothing — for the dispatcher.
    /// </summary>
    [Parameter]
    public string? View { get; set; }

    private const string ShunterView = "shunter";
    private const string DispatcherView = "dispatcher";

    private YardTopology _topology = YardTopology.Empty;
    private LabelTranslator _labelTranslator = new();
    private bool _showGrid = true;
    private bool _invertView;
    private bool _isBusy;
    private bool _keyboardCaptured;
    private OperatorRole _role;

    private string _stationName = "";

    private IReadOnlyList<ShuntingArea> ShuntingAreas =>
        YardDataService.GetStationData(_stationName)?.ShuntingAreas ?? [];

    protected override void OnInitialized()
    {
        YardDataService.DataChanged += OnDataChanged;
        ShuntingAreaService.ShuntingAreaChanged += OnShuntingAreaChanged;
        ShuntingAreaService.ReleaseRequestChanged += OnReleaseRequestChanged;
    }

    protected override void OnParametersSet()
    {
        var station = Station ?? "";
        var view = View ?? "";

        // "/shunter" and "/dispatcher" without a station name mean the default station.
        if (view.Length == 0 && IsViewName(station))
        {
            view = station;
            station = "";
        }

        if (station.Length > 0 && !YardDataService.AvailableStations.Any(s => s.Equals(station, StringComparison.OrdinalIgnoreCase)))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _role = ShunterView.Equals(view, StringComparison.OrdinalIgnoreCase) ? OperatorRole.Shunter : OperatorRole.Dispatcher;
        _stationName = station.Length > 0 ? station : YardDataService.CurrentStationName;

        var data = YardDataService.GetStationData(_stationName);
        if (data is not null)
        {
            _topology = data.Topology;
            _labelTranslator = data.LabelTranslator;
        }
    }

    private static bool IsViewName(string value) =>
        ShunterView.Equals(value, StringComparison.OrdinalIgnoreCase) ||
        DispatcherView.Equals(value, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        KeyboardCapture.StationName = _stationName;

        // The shunter works on a tablet without a keyboard, and must not be able to type past
        // what the view offers, so key capture belongs to the dispatcher view alone.
        if (_role == OperatorRole.Dispatcher && !_keyboardCaptured)
        {
            _keyboardCaptured = true;
            await KeyboardCapture.InitializeAsync();
        }
        else if (_role == OperatorRole.Shunter && _keyboardCaptured)
        {
            _keyboardCaptured = false;
            await KeyboardCapture.DisposeAsync();
        }
    }

    private void SwitchView()
    {
        var view = _role == OperatorRole.Shunter ? DispatcherView : ShunterView;
        Navigation.NavigateTo($"/{Uri.EscapeDataString(_stationName)}/{view}");
    }

    private string Translate(string text) =>
        _labelTranslator.Translate(text, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);

    private void OnDataChanged(StationDataChange args)
    {
        if (!args.StationName.Equals(_stationName, StringComparison.OrdinalIgnoreCase))
            return;

        _topology = args.Topology;
        var data = YardDataService.GetStationData(_stationName);
        if (data is not null)
            _labelTranslator = data.LabelTranslator;
        InvokeAsync(StateHasChanged);
    }

    private void OnShuntingAreaChanged(ShuntingAreaFeedback feedback)
    {
        if (feedback.StationName.Equals(_stationName, StringComparison.OrdinalIgnoreCase))
            InvokeAsync(StateHasChanged);
    }

    private void OnReleaseRequestChanged(ShuntingAreaRequestFeedback feedback)
    {
        if (feedback.StationName.Equals(_stationName, StringComparison.OrdinalIgnoreCase))
            InvokeAsync(StateHasChanged);
    }

    /// <summary>Hands the area back to the interlocking, which only the dispatcher can undo.</summary>
    private void HandBackArea(int areaNumber) => EnqueueCommand($"A{areaNumber}-");

    /// <summary>
    /// Asks the dispatcher for an area, or withdraws the request. Nothing moves until the
    /// dispatcher answers with <c>A{area}+</c>.
    /// </summary>
    private void RequestArea(int areaNumber, bool requested) =>
        ShuntingAreaService.SetReleaseRequest(_stationName, areaNumber, requested);

    /// <summary>Releases the area, which is the dispatcher's <c>A{area}+</c>; that also clears the request.</summary>
    private void AcceptArea(int areaNumber) => EnqueueCommand($"A{areaNumber}+");

    /// <summary>Turns the request down. The area stays locked and the shunter's chip stops blinking.</summary>
    private void RejectArea(int areaNumber) =>
        ShuntingAreaService.SetReleaseRequest(_stationName, areaNumber, false);

    private async Task QueryPointStatesAsync()
    {
        _isBusy = true;
        try
        {
            var data = YardDataService.GetStationData(_stationName);
            if (data is null) return;

            var addresses = data.Points
                .Where(p => !p.IsAddressOnly)
                .SelectMany(p => p.StraightAddresses.Concat(p.DivergingAddresses))
                .Select(Math.Abs)
                .Distinct()
                .Order();

            foreach (var address in addresses)
            {
                await YardController.SendPointStateRequestAsync(address, CancellationToken.None);
                await Task.Delay(100);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ResetAllPointsAsync()
    {
        EnqueueCommand("==");
    }

    private void SetAllSignalsRedAsync()
    {
        EnqueueCommand("**");
    }

    private void EnqueueCommand(string command)
    {
        var keys = command.Select(c => new ConsoleKeyInfo(c, default, false, false, false));
        KeyReader.EnqueueKeys(keys, _stationName, _role);
    }

    public async ValueTask DisposeAsync()
    {
        YardDataService.DataChanged -= OnDataChanged;
        ShuntingAreaService.ShuntingAreaChanged -= OnShuntingAreaChanged;
        ShuntingAreaService.ReleaseRequestChanged -= OnReleaseRequestChanged;
        await KeyboardCapture.DisposeAsync();
    }
}
