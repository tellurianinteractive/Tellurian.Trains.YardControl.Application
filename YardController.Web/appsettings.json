{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Tellurian.Trains.Communications.Channels": "Information",
      "Tellurian.Trains.Adapters.Z21": "Information",
      "YardController.Web.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  // Language": "Starting language for this installation: en, sv, da, nb or de. A browser's own cookie or Accept-Language still wins, and the panel follows whatever the browser resolved to.",
  "Language": "en",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5180" // This will make the yard display when opening a web browser at http://your.computers.ip.address:5180
      }
    }
  },
  "Stations": [ // The first station will be the default one. Other stations can be displayed by adding /stationname to the web browser url above.
    {
      "Name": "Munkeröd",
      "DataFolder": "Data\\Munkeröd.txt",
      "InputDevice": "StreamDeck"
    },
    {
      "Name": "Rotebro",
      "DataFolder": "Data\\Rotebro.txt",
      "InputDevice": "StreamDeck"
    },
    {
      "Name": "Steinsnes",
      "DataFolder": "Data\\Steinsnes.txt",
      "InputDevice": "StreamDeck"
    }
  ],
  "Panel": { // This is configuration of the StreamDeck input device.
    "Rotate180": true,
    "InvertKeys": true,
    "Brightness": 80,
    "ReconnectSeconds": 5
  },
  "CommandStation": {
    "Type": "Z21", // Change type Z21 or Serial.
    "InterCommandDelayMs": 200,
    "SerialPort": {
      "PortName": "COM3", // Check in the computer which serial port the USB dongle is connected as.
      "BaudRate": 57600
    },
    "Z21": { // This is ROCO's default settings for Z21 on the network. You need a router confgured to 192.168.0.1
      "Address": "192.168.0.111", 
      "CommandPort": 21105,
      "FeedbackPort": 21106
    }
  }
}
